+    rc = sceKernelMapDirectMemory(&map, size, MAP_PROTECTION, 0, start, 0x4000);
+    if (rc != 0 || !map) {
+        sceKernelReleaseDirectMemory(start, size);
+        return rc != 0 ? rc : -1;
+    }
+    *memory = map;
+    *direct = start;
+    *block_bytes = size;
+    return 0;
