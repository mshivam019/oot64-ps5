+// Shoulder shortcuts work across the menu without requiring a mouse or header focus.
+static bool CyclePS5MenuSelection(const std::vector<std::string>& choices, std::string& selection,
+                                  ImGuiKey previous, ImGuiKey next) {
+    if (choices.empty() || !CVarGetInteger(CVAR_IMGUI_CONTROLLER_NAV, 0) || ImGui::IsAnyItemActive() ||
+        ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId | ImGuiPopupFlags_AnyPopupLevel)) return false;
+    const int direction = int(ImGui::IsKeyPressed(next, false)) - int(ImGui::IsKeyPressed(previous, false));
+    if (!direction) return false;
+    auto found = std::find(choices.begin(), choices.end(), selection);
+    const int index = found == choices.end() ? 0 : int(found - choices.begin());
+    selection = choices[(index + direction + int(choices.size())) % choices.size()];
+    return true;
+}
