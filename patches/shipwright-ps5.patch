+static bool BeginMenuChild(const char* id, const ImVec2& size = ImVec2(0, 0),
+                           ImGuiChildFlags childFlags = ImGuiChildFlags_None,
+                           ImGuiWindowFlags windowFlags = ImGuiWindowFlags_None) {
