diff --git a/soh/soh/PS5FramePacer.h b/soh/soh/PS5FramePacer.h
new file mode 100644
--- /dev/null
+++ b/soh/soh/PS5FramePacer.h
@@ -0,0 +1,33 @@
+#pragma once
+
+// Deadlines are in monotonic seconds. A game tick advances the timeline once,
+// regardless of how many of its interpolated pictures the renderer can finish.
+class PS5FramePacer {
+  public:
+    void BeginTick(double now, int updateRate, int targetFps) {
+        const double duration = updateRate / 60.0;
+        if (updateRate != mUpdateRate || targetFps != mTargetFps || now - mDeadline > 0.25 ||
+            now < mDeadline - duration) {
+            mDeadline = now;
+        }
+        mStart = mDeadline;
+        mDeadline += duration;
+        mUpdateRate = updateRate;
+        mTargetFps = targetFps;
+    }
+
+    bool ShouldRender(double now, float phase) const {
+        return now < mStart + (mDeadline - mStart) * phase;
+    }
+
+    void Reset() {
+        mUpdateRate = 0;
+        mTargetFps = 0;
+    }
+
+  private:
+    double mStart = 0.0;
+    double mDeadline = 0.0;
+    int mUpdateRate = 0;
+    int mTargetFps = 0;
+};
